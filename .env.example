# Copie este arquivo para ".env" e ajuste os valores.
# Se usar python-dotenv, carregue-o no topo do app.py (opcional):
#   from dotenv import load_dotenv; load_dotenv()

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Chave de criptografia (Fernet) usada para cifrar/decifrar os valores
# sensiveis abaixo. Gere a sua com:
#   python3 crypto_utils.py gerar-chave
ENCRYPTION_KEY=gere-a-sua-com-crypto_utils.py

# DATABASE_URL, INTEGRA_DATABASE_URL, ADMIN_DEFAULT_LOGIN e
# ADMIN_DEFAULT_SENHA sao guardados CIFRADOS aqui (nunca em texto puro).
# Para gerar cada valor, com ENCRYPTION_KEY ja definida acima:
#   python3 crypto_utils.py cifrar "postgresql://usuario:senha@host:5432/sop"
#   python3 crypto_utils.py cifrar "postgresql://usuario:senha@host:5432/isivitaedb_hm"
#   python3 crypto_utils.py cifrar "admin"
#   python3 crypto_utils.py cifrar "troque-esta-senha"
DATABASE_URL=cole-aqui-o-valor-cifrado
INTEGRA_DATABASE_URL=cole-aqui-o-valor-cifrado

ADMIN_DEFAULT_LOGIN=cole-aqui-o-valor-cifrado
ADMIN_DEFAULT_SENHA=cole-aqui-o-valor-cifrado

PAINEL_POLL_INTERVAL_MS=5000
